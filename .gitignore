# Dependências binárias: baixadas por `npm run deps` (scripts/baixar-dependencias.sh)
public/opencv/
public/cascades/
node_modules/
dist/
.DS_Store
*.log

# Segredos locais (use .env.example como modelo)
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# Terraform: estado e variáveis ficam no Azure Blob Storage / GitHub Secrets
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# API (Python): banco local, fotos enviadas e caches
api/var/
__pycache__/
*.pyc
.pytest_cache/
.venv/
# Alvo de sondagem da URL pública (copiado de azure.yml.example)
observability/prometheus/alvos/azure.yml
# Senha do admin do Grafana (Docker secret)
observability/grafana/admin-password
# Camadas bronze/silver/gold geradas pelo pipeline
pipeline-dados/data/
