# Copie para .env (não versionado). Sem a chave, o assistente usa respostas por regras.
OPENROUTER_API_KEY=
# Token do robô de RPA (UiPath) para /api/chamados/*
CL_RPA_TOKEN=troque-por-um-token-longo
# Sal do hash do dispositivo (LGPD)
CL_SAL_DISPOSITIVO=troque-por-um-valor-aleatorio
# OpenRouteService (rota para cadeira de rodas e matriz para escolher a melhor entrada). Opcional.
ORS_API_KEY=
# Token de administração (Painel ADM em /adm e fila de moderação). Sem ele, vale o CL_RPA_TOKEN.
CL_ADMIN_TOKEN=
# MOCK de acesso: sem CL_ADMIN_TOKEN nem CL_RPA_TOKEN, o painel aceita o token "adm-demo".
# Em qualquer ambiente público, defina um token e use CL_ADMIN_DEMO=0.
CL_ADMIN_DEMO=1
# Token para o Prometheus ler /metrics pela internet (sem ele, /metrics só responde na rede interna).
CL_METRICS_TOKEN=

# CORS (front no Vercel chamando esta API no Render como reserva).
# Padrão: qualquer https://*.vercel.app. Para travar no seu domínio, ex.:
# CL_CORS_ORIGENS_REGEX=https://caminho-livre(-[a-z0-9-]+)?\.vercel\.app
CL_CORS_ORIGENS=http://localhost:5173
# CL_CORS_ORIGENS_REGEX=
