# syntax=docker/dockerfile:1.7
# =============================================================================
# Caminho Livre - imagem única para deploy (Render, Railway, Fly, Azure...):
# front React compilado + API FastAPI no mesmo container e na mesma origem
# (a CSP connect-src 'self' continua valendo). Porta: $PORT (padrão 8090).
# =============================================================================
FROM node:22-alpine AS front
WORKDIR /app
RUN apk add --no-cache curl
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Chave PÚBLICA de navegador da MapTiler (não é segredo: vai no JS do front e é
# restrita por domínio no painel). Sem ela, o mapa usa os tiles do OpenStreetMap.
ARG VITE_MAPTILER_KEY=""
# O opencv.js avulso (10 MB) só serve ao avaliacao.html (dev): o app usa o OpenCV empacotado no worker.
RUN npm run deps && npm run build && rm -rf dist/opencv

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    CL_DB_PATH=/data/caminho_livre.db CL_FOTOS_DIR=/data/fotos CL_FRONT_DIR=/srv/dist PORT=8090
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --no-create-home app \
    && mkdir -p /data && chown app:app /data
WORKDIR /srv
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY api/app/ app/
COPY api/dados/ dados/
COPY api/contexto/ contexto/
COPY --from=front /app/dist/ dist/
USER 10001
EXPOSE 8090
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
